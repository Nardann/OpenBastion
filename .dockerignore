# Root .dockerignore — applies to the FRONTEND build context (`.`).
# The backend build context lives at `./backend` and has its own
# `backend/.dockerignore`.

# Secrets / runtime state
.env
.env.*

# VCS / IDE / agent state
.git
.gitignore
.claude
.vscode
*.log

# Backend code (built by a separate Dockerfile with its own context)
backend

# Host-mounted volumes — never ship them inside an image
pg_data
certs

# Build artefacts
client/node_modules
client/dist
coverage

# Docs & dev-only files
README.md
docs
VALIDATION_CHECKLIST.md
